# ---- Public address ---------------------------------------------------
# The ONE address browsers use for the whole stack (CKAN at /, GeoServer at /geoserver/),
# served by the `edge` reverse proxy on EDGE_PORT. For a public demo set it to the tunnel
# address, e.g. PUBLIC_BASE_URL=https://deden.ngrok.dev, then `docker compose up -d` and
# re-run the seed so resource URLs are rewritten (see README "Running behind a public URL").
PUBLIC_BASE_URL=http://localhost:8000
EDGE_PORT=8000

# ---- CKAN -------------------------------------------------------------
CKAN_PORT=5000
CKAN_SITE_URL=${PUBLIC_BASE_URL}
CKAN_SYSADMIN_NAME=admin
CKAN_SYSADMIN_PASSWORD=admin12345
CKAN_SYSADMIN_EMAIL=admin@example.org
CKAN_DB_USER=ckan
CKAN_DB_PASSWORD=ckan
CKAN_DB_NAME=ckan

# ---- GeoServer / PostGIS -------------------------------------------------
GEOSERVER_PORT=8080
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver
# GeoServer base URL as seen from the *browser* (stored in CKAN resources as .../amconnect/wms etc.)
GEOSERVER_PUBLIC_URL=${PUBLIC_BASE_URL}/geoserver
POSTGIS_DB=gis
POSTGIS_USER=gis
POSTGIS_PASSWORD=gis

# ---- Federation test sources (harvest demo) ------------------------------
MOCK_CKAN_PORT=5001
PYCSW_PORT=8001
